<services>
  <!-- Fetch the upstream tag. The GitHub Action rewrites <revision> when a new release lands. -->
  <service name="tar_scm">
    <param name="url">https://github.com/storytold/craft-launcher.git</param>
    <param name="scm">git</param>
    <param name="revision">v0.2.1</param>
    <param name="filename">craft-launcher</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="exclude">.github</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <!-- Copy the version from the tarball name into the spec's Version: line. -->
  <service name="set_version"/>
  <!-- Vendor every crate so the build runs offline. update=false keeps upstream's Cargo.lock. -->
  <service name="cargo_vendor">
    <param name="src">craft-launcher-*.tar.zst</param>
    <param name="compression">zst</param>
    <param name="update">false</param>
  </service>
</services>
